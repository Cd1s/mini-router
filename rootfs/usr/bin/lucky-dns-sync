#!/bin/sh
# Map enabled Lucky reverse-proxy domains to the router's LAN IP (dnsmasq addn-hosts).
# Token lives outside the repo in /etc/lucky/open-token.
TOKEN="$(cat /etc/lucky/open-token 2>/dev/null)"
[ -n "$TOKEN" ] || exit 1
SAFE="$(sed -n 's/.*"SafeURL" *: *"\([^"]*\)".*/\1/p' /etc/lucky/lucky_base.lkcf 2>/dev/null | head -1)"
BASE="http://127.0.0.1:16601/${SAFE:-lucky}"
LAN_IP="$(sed -n 's/^  ipv4: *\([0-9.]*\)\/.*/\1/p' /etc/mini-router/router.yaml | head -1)"
OUT=/etc/lucky/dnsmasq.hosts
TMP="/tmp/lucky-dnsmasq.hosts.$$"
{
	echo "# generated by lucky-dns-sync: enabled Lucky WebService domains -> $LAN_IP"
	curl -fsS -H "OpenToken: $TOKEN" "$BASE/api/webservice/rules" 2>/dev/null | jq -r '.ruleList[]?.RuleKey' |
	while read -r key; do
		[ -n "$key" ] || continue
		curl -fsS -H "OpenToken: $TOKEN" "$BASE/api/webservice/rule/$key" 2>/dev/null |
			jq -r '.rule.ProxyList[]? | select(.Enable == true) | .Domains[]?' | grep -E '^[A-Za-z0-9_.-]+$'
	done | sort -u | sed "s/^/$LAN_IP /"
} > "$TMP"
[ "$(grep -vc '^#' "$TMP")" -gt 0 ] || { rm -f "$TMP"; exit 1; }
if ! cmp -s "$TMP" "$OUT"; then
	mv "$TMP" "$OUT"
	pkill -HUP -x dnsmasq 2>/dev/null   # re-read addn-hosts
else
	rm -f "$TMP"
fi
