#!/sbin/openrc-run
description="WiFi access points (hostapd, mt76)"
supervisor=supervise-daemon
command=/usr/sbin/hostapd
respawn_delay=3
respawn_max=0
depend() {
	need mr-network
	before mr-firewall
}
start_pre() {
	sh /etc/mini-router/gen/network.sh >/dev/null 2>&1	# make sure phyN-ap0 netdevs exist
	# only radios router.yaml still has: network.sh deletes the AP netdev of a radio that was removed,
	# but its old hostapd config file stays behind
	command_args=""
	for f in /etc/hostapd/hostapd-phy*.conf; do
		[ -e "$f" ] || continue
		i=$(sed -n 's/^interface=//p' "$f")
		[ -n "$i" ] && [ -e "/sys/class/net/$i" ] && command_args="$command_args $f"
	done
	[ -n "$command_args" ] || { eerror "no hostapd config for an existing radio (run mr apply)"; return 1; }
	return 0
}
start_post() {
	# tx power, bridge isolation of isolated SSIDs (waits for BSSes that come up late, e.g. after DFS CAC),
	# then the firewall again so the offload flowtable covers every AP netdev
	( sleep 8; sh /etc/mini-router/gen/wifi-post.sh; /usr/sbin/mr fw ) >/dev/null 2>&1 &
}
