#!/sbin/openrc-run
description="web UI + status panel (busybox httpd)"
supervisor=supervise-daemon
command=/bin/busybox-extras
# a crash loop stops after 10 respawns in 10 minutes: mr doctor reports it, mr doctor --heal restarts it
respawn_delay=3
respawn_max=10
respawn_period=600
depend() {
	need mr-network
	after mr-firewall
}
start_pre() {
	# PANEL_ADDR is 0.0.0.0 so a LAN renumber keeps both origins reachable. The firewall
	# normally starts first (depend() above). If its table is absent, bind only the LAN
	# address so an operator can repair the firewall without exposing the panel on WAN.
	if [ "${PANEL_ADDR:-}" = 0.0.0.0 ] && ! nft list chain inet mr input >/dev/null 2>&1; then
		PANEL_ADDR=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
	ewarn "firewall not loaded: web UI listens on the LAN address only"
	fi
	if [ -z "${PANEL_ADDR:-}" ]; then
		PANEL_ADDR=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
	fi
	command_args="httpd -f -p ${PANEL_ADDR:-0.0.0.0}:80 -h /www"
}
