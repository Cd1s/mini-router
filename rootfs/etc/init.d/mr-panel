#!/sbin/openrc-run
description="web UI + status panel (busybox httpd)"
supervisor=supervise-daemon
command=/bin/busybox-extras
depend() {
	need mr-network
}
start_pre() {
	# PANEL_ADDR: the main LAN address, from /etc/conf.d/mr-panel (rendered by mr from lan.ipv4;
	# a LAN address change rewrites it and restarts this service)
	if [ -z "${PANEL_ADDR:-}" ]; then
		PANEL_ADDR=$(sed -n 's/^  ipv4: *\([0-9.]*\)\/.*/\1/p' /etc/mini-router/router.yaml | head -1)
	fi
	command_args="httpd -f -p ${PANEL_ADDR:-0.0.0.0}:80 -h /www"
}
