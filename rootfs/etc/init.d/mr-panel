#!/sbin/openrc-run
description="web UI + status panel (busybox httpd)"
supervisor=supervise-daemon
command=/bin/busybox-extras
# a crash loop stops after 10 respawns in 10 minutes: mr doctor reports it, mr doctor --heal restarts it
respawn_delay=3
respawn_max=10
respawn_period=600
depend() {
	need mr-network
}
start_pre() {
	# Bind IPv6 wildcard: BusyBox httpd accepts IPv4-mapped connections on Alpine, so this serves
	# both LAN families. The firewall and apiSetup's interface check keep WAN-side setup blocked.
	if [ -z "${PANEL_ADDR:-}" ]; then
		PANEL_ADDR=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
	fi
	command_args="httpd -f -p [::]:80 -h /www"
}
