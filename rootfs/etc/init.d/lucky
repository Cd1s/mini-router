#!/sbin/openrc-run
description="Lucky (DDNS, reverse proxy)"
supervisor=supervise-daemon
command=/usr/bin/lucky
command_args="-cd /etc/lucky"
supervise_daemon_args="--env GOGC=50 --env GOMEMLIMIT=20MiB"
respawn_delay=5
# a crash loop stops after 10 respawns in 10 minutes: mr doctor reports it, mr doctor --heal restarts it
respawn_max=10
respawn_period=600
depend() {
	need net
	after mr-firewall
}
