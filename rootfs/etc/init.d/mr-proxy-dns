#!/sbin/openrc-run
# DNS for proxied LAN clients (proxy module, docs/modules/proxy.md): a second dnsmasq, no DHCP.
# nftables redirects port 53 of LAN-zone clients (not bypass devices) here. Proxied domains are
# forwarded to sing-box (fake-ip); everything else resolves like the main dnsmasq.
description="proxy DNS (dnsmasq for proxied LAN clients)"
supervisor=supervise-daemon
cfg=/etc/mini-router/gen/proxy-dns.conf
command=/usr/sbin/dnsmasq
command_args="--keep-in-foreground --pid-file= --user=dnsmasq --group=dnsmasq --conf-file=$cfg"
respawn_delay=2
respawn_max=0

depend() {
	need mr-network
	after dnsmasq mr-proxy
}

start_pre() {
	[ -f "$cfg" ] || { eerror "$cfg missing (run mr apply)"; return 1; }
	# dnsmasq will not start if the directory of its resolv-file (written by pppd) does not exist yet
	mkdir -p /run/ppp
	/usr/sbin/dnsmasq --test --conf-file="$cfg" >/dev/null 2>&1 || {
		eerror "$cfg: dnsmasq --test failed"
		return 1
	}
}
