#!/sbin/openrc-run
# compressed swap in RAM (zstd); sized at 1/4 of memory. With MGLRU, the working set of the last
# second is never evicted: when memory cannot hold it, the OOM killer acts instead of thrashing.
description="zram swap"
depend() {
	need localmount
}
start() {
	ebegin "Enabling zram swap"
	[ ! -w /sys/kernel/mm/lru_gen/min_ttl_ms ] || echo 1000 > /sys/kernel/mm/lru_gen/min_ttl_ms
	modprobe -q zram 2>/dev/null
	[ -e /sys/block/zram0 ] || { eend 1 "no zram"; return 1; }
	if ! grep -q '^/dev/zram0 ' /proc/swaps; then
		# configure only an unused device (a restart finds it initialized: "Resource busy")
		if [ "$(cat /sys/block/zram0/disksize)" = 0 ]; then
			for a in zstd lzo-rle lzo; do
				echo $a > /sys/block/zram0/comp_algorithm 2>/dev/null && break
			done
			echo $(( $(awk '/MemTotal/{print $2}' /proc/meminfo) * 1024 / 4 )) > /sys/block/zram0/disksize
		fi
		# the device node appears asynchronously (mdev) right after the module loads: at boot mkswap
		# ran before it existed and the service failed
		i=0
		while [ ! -b /dev/zram0 ] && [ $i -lt 50 ]; do
			sleep 0.1
			i=$((i + 1))
		done
		[ -b /dev/zram0 ] || mknod /dev/zram0 b "$(cut -d: -f1 /sys/block/zram0/dev)" "$(cut -d: -f2 /sys/block/zram0/dev)"
		mkswap /dev/zram0 >/dev/null && swapon -p 100 /dev/zram0
	fi
	eend $?
}
stop() {
	swapoff /dev/zram0 2>/dev/null
	echo 1 > /sys/block/zram0/reset 2>/dev/null
	return 0
}
