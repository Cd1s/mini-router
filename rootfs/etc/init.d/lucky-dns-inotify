#!/sbin/openrc-run
description="Lucky domains -> dnsmasq hosts"
supervisor=supervise-daemon
command=/usr/bin/lucky-dns-inotify
respawn_delay=30
# a crash loop stops after 10 respawns in 10 minutes: mr doctor reports it, mr doctor --heal restarts it
respawn_max=10
respawn_period=600
depend() {
	need lucky dnsmasq
}
