#!/sbin/openrc-run
# DHCPv4 client of one WAN (router.yaml wan[].proto: dhcp). The instances /etc/init.d/mr-udhcpc.<wan>
# are generated by mr: they set MR_WAN_DEV and source this file. busybox udhcpc stays in the
# foreground under supervise-daemon; its event script hands every lease change to `mr wan dhcp`,
# which sets the address, the per-WAN routes / rules and the upstream DNS.
WAN="${RC_SVCNAME#mr-udhcpc.}"
description="DHCP client ${WAN}"
supervisor=supervise-daemon
command=/sbin/udhcpc
# -f foreground, -R release on stop, -S syslog; 4 discovers 3 s apart, then retry every 10 s forever
command_args="-f -R -S -t 4 -T 3 -A 10 -i ${MR_WAN_DEV:-} -s /usr/libexec/mr/net-udhcpc"
respawn_delay=5
respawn_max=0
depend() {
	need mr-network
	after mr-firewall
}
start_pre() {
	if [ "$WAN" = "$RC_SVCNAME" ] || [ -z "${MR_WAN_DEV:-}" ]; then
		eerror "use an instance generated by mr apply, e.g. mr-udhcpc.wan"
		return 1
	fi
	ip link set "$MR_WAN_DEV" up
}
