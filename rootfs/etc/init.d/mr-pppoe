#!/sbin/openrc-run
# PPPoE of one WAN. Instances /etc/init.d/mr-pppoe.<wan> are generated by mr (they source this file;
# older images use symlinks); settings are in the generated peers file /etc/ppp/peers/<wan>.
WAN="${RC_SVCNAME#mr-pppoe.}"
description="PPPoE ${WAN}"
supervisor=supervise-daemon
command=/usr/sbin/pppd
command_args="call ${WAN}"
respawn_delay=5
# never gives up: the uplink / WiFi is the way back in (a router far from home)
respawn_max=0
depend() {
	need mr-network
	after mr-firewall
}
start_pre() {
	[ "$WAN" != "$RC_SVCNAME" ] || { eerror "use an instance generated by mr apply, e.g. mr-pppoe.wan"; return 1; }
	[ -f "/etc/ppp/peers/$WAN" ] || { eerror "/etc/ppp/peers/$WAN missing (run mr apply)"; return 1; }
	modprobe -q pppoe 2>/dev/null
	return 0
}
