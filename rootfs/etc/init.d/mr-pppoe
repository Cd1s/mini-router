#!/sbin/openrc-run
# PPPoE of one WAN. Instances /etc/init.d/mr-pppoe.<wan> are generated by mr (they source this file;
# older images use symlinks); settings are in the generated peers file /etc/ppp/peers/<wan>.
WAN="${RC_SVCNAME#mr-pppoe.}"
description="PPPoE ${WAN}"
supervisor=supervise-daemon
# pppoe-dial waits for the WANs before this one in multiwan.dial_order, then execs `pppd call ${WAN}`
command=/usr/libexec/mr/pppoe-dial
command_args="${WAN}"
# stopping (service restart, reboot, shutdown): pppd sends LCP Terminate-Request and, once that is answered or has
# timed out (pppoe-dial: lcp-max-terminate 1 -> 3 s), the PADT that frees the session at the ISP. supervise-daemon
# stops waiting after 5 s by default, which a slow or silent ISP could outlast; the reboot then went on without
# the PADT and the ISP kept counting the old session (AIS: the next dial lands in a walled garden)
retry="SIGTERM/10"
respawn_delay=5
# never gives up: the uplink / WiFi is the way back in (a router far from home)
respawn_max=0
depend() {
	need mr-network
	after mr-firewall
}
start_pre() {
	[ "$WAN" != "$RC_SVCNAME" ] || { eerror "use an instance generated by mr apply, e.g. mr-pppoe.wan"; return 1; }
	[ -f "/etc/ppp/peers/$WAN" ] || { eerror "/etc/ppp/peers/$WAN missing (run mr apply)"; return 1; }
	modprobe -q pppoe 2>/dev/null
	if [ ! -e /proc/net/pppoe ]; then	# e.g. Alpine's linux-virt kernel: fail now, not after the apply's wait
		msg="kernel $(uname -r) has no PPPoE (modprobe pppoe failed); Alpine: apk add linux-lts, reboot"
		logger -t "$RC_SVCNAME" -p daemon.err "$msg"
		eerror "$msg"
		return 1
	fi
	return 0
}
