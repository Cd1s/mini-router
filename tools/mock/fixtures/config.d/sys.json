{
 "config": {
  "system": {
   "hostname": "mini-router",
   "timezone": "<+08>-8",
   "ntp": [
    "ntp.tencent.com",
    "ntp1.aliyun.com",
    "ntp.ntsc.ac.cn",
    "cn.ntp.org.cn"
   ],
   "ntp_server": true,
   "sysctl": {
    "net.ipv4.igmp_max_memberships": "100",
    "net.ipv4.tcp_congestion_control": "bbr",
    "net.ipv4.tcp_fin_timeout": "30",
    "net.ipv4.tcp_keepalive_time": "120"
   },
   "zram": true
  },
  "services": {
   "tailscale": {
    "enabled": true,
    "port": 41641
   },
   "lucky": {
    "enabled": true,
    "port": 16601
   },
   "dstatus": {
    "enabled": true
   },
   "stubby": {
    "enabled": true
   },
   "ssh": {
    "enabled": true,
    "port": 22,
    "password_login": false,
    "lan_only": true,
    "authorized_keys": [
     "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDOGJDCePFDR8nNJPCzmDX6zxWpEH/sQ3kBFp/rZ0D2I lab-laptop"
    ]
   },
   "panel": {
    "enabled": true
   },
   "ddns": {
    "enabled": true,
    "interval": 10,
    "records": [
     {"name": "home.example.com", "provider": "cloudflare", "zone": "example.com", "token_secret": "cf_ddns_token", "ipv4": "active", "ipv6": "router"},
     {"name": "nas.example.com", "provider": "cloudflare", "zone": "example.com", "token_secret": "cf_ddns_token", "ipv4": "off", "ipv6": "::10", "ttl": 300},
     {"name": "cn.example.net", "provider": "alidns", "zone": "example.net", "key_id": "LTAI0000mockkey00000", "key_secret": "ali_dns_key", "ipv4": "url:https://api.ipify.org", "ipv6": "mac:02:00:00:00:00:10"},
     {"name": "myhome.duckdns.org", "provider": "duckdns", "token_secret": "duck_token", "ipv4": "active", "ipv6": "router"},
     {"name": "hook.example.org", "provider": "webhook", "url": "https://hooks.example.org/ddns?host={name}&ip={ip}", "method": "GET", "ipv4": "active", "ipv6": "off"}
    ]
   },
   "edge": {
    "enabled": true,
    "port": 8443,
    "open": true,
    "acme": {"email": "admin@example.com", "provider": "cloudflare", "token_secret": "cf_ddns_token", "wildcard": ["example.com"]},
    "routes": [
     {"name": "nas", "host": "nas.example.com", "to": "http://192.168.1.10:5000"},
     {"name": "ha", "host": "ha.example.com", "to": "http://192.168.1.20:8123", "allow": ["lan", "198.51.100.0/24"]},
     {"name": "cam", "host": "cam.home.example.org", "to": "https://192.168.1.30", "allow": ["lan"]}
    ]
   }
  },
  "schedules": [
   {
    "name": "weekly-reboot",
    "cron": "30 4 * * 1",
    "action": "reboot"
   },
   {
    "name": "wifi-restart",
    "cron": "0 5 * * *",
    "action": "restart",
    "target": "mr-hostapd"
   },
   {
    "name": "redial-wan2",
    "cron": "0 */6 * * *",
    "action": "reconnect",
    "target": "wan2"
   },
   {
    "name": "monthly-reboot",
    "enabled": false,
    "cron": "0 2 1 * *",
    "action": "reboot"
   }
  ],
  "notify": {
   "channels": [
    {"name": "phone", "type": "telegram", "token_secret": "notify_tg_token", "chat_id": "-1001234567890"},
    {"name": "ha", "type": "webhook", "url_secret": "notify_ha_url", "format": "json"}
   ],
   "events": ["wan_down", "wan_up", "failover", "rollback", "login_lock", "new_device", "boot", "upgrade", "doctor"],
   "rate": 10,
   "quiet_hours": "23:00-07:00",
   "doctor_interval": 30
  }
 },
 "secrets_set": {
  "cf_ddns_token": true,
  "notify_tg_token": true,
  "notify_ha_url": true,
  "ali_dns_key": true,
  "duck_token": true
 }
}
